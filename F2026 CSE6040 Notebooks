    {
      "cell_type": "code",
      "source": [
        "def create_rules_from_counts(pair_counts, item_counts):\n",
        "    rules = {} # (item_a, item_b) -> conf (item_a => item_b)\n",
        "\n",
        "    for (a, b) in pair_counts:\n",
        "        assert a in item_counts\n",
        "\n",
        "        conf_ab = pair_counts[(a, b)] / item_counts[a]\n",
        "        rules[(a, b)] = conf_ab\n",
        "\n",
        "    return rules\n"
      ],
