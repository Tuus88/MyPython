        "def filter_rules_by_conf(rules, threshold):\n",
        "    # order of processing\n",
        "    # 1. evaluate rules.items()\n",
        "    # 2. if condition\n",
        "    # 3. rule:conf - add qualifying pair to the new dict (rule=key, conf=value)\n",
        "    # 4. repeat for every pair\n",
        "    # 5. return the completed dict\n",
        "    return {rule: conf for rule, conf in rules.items() if conf >= threshold}\n",
        "\n",
        "# Alternative:\n",
        "    filtered_rules = {}\n",
        "\n",
